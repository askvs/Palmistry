# Application
APP_NAME="Palmistry & Tarot Intelligence Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security (placeholders only — never commit real secrets)
SECRET_KEY=<YOUR_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# OAuth2 (§49.3 default: Google). Empty = /auth/google/authorize returns 503.
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
REFRESH_COOKIE_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=<YOUR_DATABASE_URL>
DATABASE_TEST_URL=<YOUR_DATABASE_TEST_URL>

# AI providers (§49.7 defaults)
OPENAI_API_KEY=<YOUR_API_KEY>
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Limits
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Live consultation & booking module
# Minimum notice a seeker must give when booking (minutes).
BOOKING_MIN_LEAD_MINUTES=60
# How far ahead a seeker may book (days).
BOOKING_MAX_ADVANCE_DAYS=60
# Free-cancellation window before a session starts (hours).
BOOKING_CANCEL_WINDOW_HOURS=24
# Reminder lead times (minutes before the session start).
BOOKING_REMINDER_LEAD_MINUTES=1440
BOOKING_SHORT_REMINDER_LEAD_MINUTES=60
# How many days of concrete availability slots are materialised ahead.
BOOKING_SLOT_HORIZON_DAYS=21
# Cron hour (server local time) that rolls the slot horizon forward.
BOOKING_ROLLOUT_HOUR=1

# Google Calendar / Meet — live consultation & booking module
# Master switch. When false the booking module still works but no calendar
# event is created and `bookings.calendar_sync_status` stays "disabled".
GOOGLE_CALENDAR_ENABLED=false
# Calendar used in service-account mode ("primary" = the service account's own).
GOOGLE_CALENDAR_ID=primary
# Path to a service-account JSON key file, or the JSON itself. Optional: the
# per-consultant OAuth connection below is preferred when present.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Ask Google to create a Meet link for each event.
GOOGLE_CALENDAR_CREATE_MEET=true
# OAuth2 callback for the "connect my Google Calendar" consultant flow.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/consultant-studio?google_calendar=callback
GOOGLE_OAUTH_TIMEOUT_SECONDS=15

# Email (SMTP) - required for email notifications
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="MysticLens Divination"

# --- Deploy / Compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=palmistry
ENVIRONMENT=production
SECRET_KEY=<YOUR_SECRET_KEY_MIN_32_CHARS>
# Compose exposes the frontend on host port 3001; adjust for other setups.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
FRONTEND_URL=http://localhost:3001
# Public URL of the API as seen by the visitor's browser. It is baked into
# the frontend bundle at build time (docker-compose build arg / Vercel env
# NEXT_PUBLIC_API_BASE_URL). For remote deployments this MUST be the public
# https:// API domain (e.g. https://api.example.com), never localhost, and
# CORS_ORIGINS above must list the deployed frontend origin.
PUBLIC_API_BASE_URL=http://localhost:8000
# Set true when the frontend and API are served from different sites
# (e.g. Vercel + Render): the refresh cookie then becomes
# SameSite=None; Secure, which cross-site fetches require. Keep false for
# plain-HTTP local development, where a None cookie would be rejected.
REFRESH_COOKIE_SECURE=false
# AWS default (Azure equivalents stay replaceable via same var names)
AWS_REGION=us-east-1
ECR_BACKEND_REPO=palmistry-backend
ECR_FRONTEND_REPO=palmistry-frontend
RDS_DATABASE_URL=<YOUR_RDS_POSTGRES_URL>
S3_UPLOADS_BUCKET=<YOUR_S3_BUCKET_EMPTY_KEEPS_LOCAL_DISK>
